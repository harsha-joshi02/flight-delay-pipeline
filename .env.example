# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mluser
POSTGRES_PASSWORD=mlpassword
POSTGRES_DB=flight_ml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://mluser:mlpassword@postgres:5432/flight_ml

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=flight-delay-prediction
MLFLOW_MODEL_NAME=flight-delay-model

# ── Prefect ───────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect:4200/api

# ── Model Configuration ───────────────────────────────────────────────────────
# Minimum AUC improvement required to promote new model to production
MODEL_PROMOTION_THRESHOLD=0.005
# Delay threshold in minutes — flights delayed >= this are labelled 1
DELAY_THRESHOLD_MINUTES=15

# ── Paths (relative to project root, overrideable for Docker) ─────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REFERENCE_DIR=data/reference
MODELS_DIR=data/models
REPORTS_DIR=data/reports

# ── Data Ingestion ────────────────────────────────────────────────────────────
# How many months of historical data to download on first run
INITIAL_MONTHS=12
# BTS download year/month to start from (leave blank to use current month - 1)
BTS_START_YEAR=
BTS_START_MONTH=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Data drift threshold — triggers retraining when PSI exceeds this value
DRIFT_PSI_THRESHOLD=0.2
# Prediction drift threshold — Wasserstein distance
PREDICTION_DRIFT_THRESHOLD=0.1

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# ── Streamlit ─────────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
